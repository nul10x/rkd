# Copy to ~/.rkd/bot.env (chmod 600). Not in the repo. No secret values here: only paths to key files.
DISCORD_GUILD_ID=000000000000000000
DISCORD_ALLOWED_USER_IDS=000000000000000000
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_BOT_TOKEN_FILE=/path/to/DISCORD_BOT_TOKEN
HELIUS_API_KEY_FILE=/path/to/HELIUS_API_KEY
RKD_SCANNER_DAILY_BUDGET=300
